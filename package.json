{
  "name": "dsh-sidebar-on-vscode",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.1.1",
  "publisher": "SaltedDoubao",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/SaltedDoubao/dsh-sidebar-on-vscode.git"
  },
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "agent",
    "ai",
    "deepseek",
    "dsh",
    "harness",
    "keybindings"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deepseekHarness",
          "title": "%view.title%",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "deepseekHarness": [
        {
          "id": "deepseekHarness.sidebar",
          "name": "%view.title%",
          "type": "webview",
          "icon": "resources/icon.png"
        }
      ]
    },
    "commands": [
      {
        "command": "deepseekHarness.newChat",
        "title": "%command.newChat%",
        "category": "%command.category%"
      },
      {
        "command": "deepseekHarness.openSettings",
        "title": "%command.openSettings%",
        "category": "%command.category%"
      },
      {
        "command": "deepseekHarness.openFullPanel",
        "title": "%command.openFullPanel%",
        "category": "%command.category%"
      },
      {
        "command": "deepseekHarness.insertSelection",
        "title": "%command.insertSelection%",
        "category": "%command.category%"
      },
      {
        "command": "deepseekHarness.insertActiveFile",
        "title": "%command.insertActiveFile%",
        "category": "%command.category%"
      },
      {
        "command": "deepseekHarness.exportSession",
        "title": "%command.exportSession%",
        "category": "%command.category%"
      },
      {
        "command": "deepseekHarness.stopHost",
        "title": "%command.stopHost%",
        "category": "%command.category%"
      },
      {
        "command": "deepseekHarness.restartHost",
        "title": "%command.restartHost%",
        "category": "%command.category%"
      },
      {
        "command": "deepseekHarness.showLogs",
        "title": "%command.showLogs%",
        "category": "%command.category%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "deepseekHarness.insertSelection",
          "when": "editorHasSelection",
          "group": "deepseekHarness@1"
        },
        {
          "command": "deepseekHarness.insertActiveFile",
          "when": "resourceScheme == file",
          "group": "deepseekHarness@2"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "deepseekHarness.host.basePort": {
          "type": "number",
          "default": 3080,
          "minimum": 1,
          "maximum": 65526,
          "description": "%configuration.host.basePort%"
        },
        "deepseekHarness.host.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.host.autoStart%"
        },
        "deepseekHarness.host.executable": {
          "type": "string",
          "default": "",
          "description": "%configuration.host.executable%"
        },
        "deepseekHarness.host.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%configuration.host.arguments%"
        },
        "deepseekHarness.host.keepAliveOnExit": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.host.keepAliveOnExit%"
        },
        "deepseekHarness.ideContext.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.ideContext.enabled%"
        },
        "deepseekHarness.ideContext.ephemeral.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.ideContext.ephemeral.enabled%"
        },
        "deepseekHarness.notifications.onCompletion": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.notifications.onCompletion%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "node esbuild.config.mjs",
    "build:webview": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "test": "node esbuild.config.mjs --tests && node --test .temp/test-dist/*.test.mjs",
    "test:e2e": "npm run build:webview && node esbuild.config.mjs --e2e && playwright test",
    "test:vscode": "npm run build:extension && node ./tests/vscode/run.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links"
  },
  "dependencies": {
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.95.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.55.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-test-renderer": "^19.1.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "ws": "^8.18.3"
  }
}
