{
  "name": "dsh-sidebar-on-vscode",
  "displayName": "DSH Sidebar on VSCode",
  "description": "A secure, capability-aware VS Code client for DeepSeek Harness.",
  "version": "1.0.0",
  "publisher": "local",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/SaltedDoubao/dsh-sidebar-on-vscode.git"
  },
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deepseekHarness",
          "title": "DSH Sidebar on VSCode",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "deepseekHarness": [
        {
          "id": "deepseekHarness.sidebar",
          "name": "DSH Sidebar on VSCode",
          "type": "webview",
          "icon": "resources/icon.png"
        }
      ]
    },
    "commands": [
      {
        "command": "deepseekHarness.newChat",
        "title": "New Chat",
        "category": "DSH Sidebar on VSCode"
      },
      {
        "command": "deepseekHarness.openSettings",
        "title": "Open Settings",
        "category": "DSH Sidebar on VSCode"
      },
      {
        "command": "deepseekHarness.openFullPanel",
        "title": "Open Full Panel",
        "category": "DSH Sidebar on VSCode"
      },
      {
        "command": "deepseekHarness.insertSelection",
        "title": "Insert Selection into Chat",
        "category": "DSH Sidebar on VSCode"
      },
      {
        "command": "deepseekHarness.insertActiveFile",
        "title": "Insert Active File into Chat",
        "category": "DSH Sidebar on VSCode"
      },
      {
        "command": "deepseekHarness.exportSession",
        "title": "Export Session",
        "category": "DSH Sidebar on VSCode"
      },
      {
        "command": "deepseekHarness.stopHost",
        "title": "Stop Host",
        "category": "DSH Sidebar on VSCode"
      },
      {
        "command": "deepseekHarness.restartHost",
        "title": "Restart Host",
        "category": "DSH Sidebar on VSCode"
      },
      {
        "command": "deepseekHarness.showLogs",
        "title": "Show Logs",
        "category": "DSH Sidebar on VSCode"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "deepseekHarness.insertSelection",
          "when": "editorHasSelection",
          "group": "deepseekHarness@1"
        },
        {
          "command": "deepseekHarness.insertActiveFile",
          "when": "resourceScheme == file",
          "group": "deepseekHarness@2"
        }
      ]
    },
    "configuration": {
      "title": "DSH Sidebar on VSCode",
      "properties": {
        "deepseekHarness.host.basePort": {
          "type": "number",
          "default": 3080,
          "minimum": 1,
          "maximum": 65526,
          "description": "First loopback port to probe; up to ten consecutive ports are checked."
        },
        "deepseekHarness.host.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start a local DeepSeek Harness host if no compatible host is already running."
        },
        "deepseekHarness.host.executable": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path or PATH command name for the dsh executable."
        },
        "deepseekHarness.host.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments inserted after the configured executable and before the dsh web command. Shell command strings are not supported."
        },
        "deepseekHarness.host.keepAliveOnExit": {
          "type": "boolean",
          "default": false,
          "description": "Keep a host started by this extension alive after the last VS Code window closes."
        },
        "deepseekHarness.ideContext.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Attach editor context to normal messages. Slash commands never receive automatic IDE context."
        },
        "deepseekHarness.notifications.onCompletion": {
          "type": "boolean",
          "default": false,
          "description": "Show a notification when a background session completes."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "node esbuild.config.mjs",
    "build:webview": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "test": "node esbuild.config.mjs --tests && node --test .temp/test-dist/*.test.mjs",
    "test:e2e": "npm run build:webview && node esbuild.config.mjs --e2e && playwright test",
    "test:vscode": "npm run build:extension && node ./tests/vscode/run.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links"
  },
  "dependencies": {
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.95.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.55.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-test-renderer": "^19.1.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "ws": "^8.18.3"
  }
}
